   "source": [
    "#1. Equilibrium Index\n",
    "l = [1,2,2,9,3,2]\n",
    "totsum = sum(l)\n",
    "leftsum =0\n",
    "for i in range (len(l)):\n",
    "    rightsum = totsum - leftsum - l[i]\n",
    "\n",
    "    if leftsum == rightsum:\n",
    "        print(i)\n",
    "        break\n",
    "        \n",
    "    leftsum += l[i]\n",
    "    \n",
    "\n",
    "#print (sum)\n"
   ]
